{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manuvra.dev/schema/crap-certificate/1",
  "title": "Manuvra source-bound exhaustive CRAP certificate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "source_tree_sha256", "policy", "tools", "environment", "crap_report"],
  "properties": {
    "schema": { "const": "manuvra/crap-certificate@1" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "source_tree_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threshold", "missing_coverage", "waivers"],
      "properties": {
        "threshold": { "const": 8 },
        "missing_coverage": { "const": "pessimistic" },
        "waivers": { "const": false }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rustc", "cargo_crap", "cargo_llvm_cov"],
      "properties": {
        "rustc": { "type": "string", "minLength": 1 },
        "cargo_crap": { "const": "cargo-crap 0.4.3" },
        "cargo_llvm_cov": { "const": "cargo-llvm-cov 0.9.0" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "architecture": { "const": "arm64" }
      }
    },
    "crap_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "threshold", "entries"],
      "properties": {
        "schema_version": { "const": 1 },
        "threshold": { "const": 8 },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["language", "file", "function", "line", "complexity", "coverage", "coverage_missing", "crap"],
            "properties": {
              "language": { "type": "string", "minLength": 1 },
              "file": { "type": "string", "pattern": "^[^/]", "minLength": 1 },
              "function": { "type": "string", "minLength": 1 },
              "line": { "type": "integer", "minimum": 1 },
              "complexity": { "type": "number", "minimum": 1 },
              "coverage": { "type": "number", "minimum": 0, "maximum": 100 },
              "coverage_missing": { "type": "boolean" },
              "crap": { "type": "number", "maximum": 8 }
            }
          }
        }
      }
    }
  }
}
