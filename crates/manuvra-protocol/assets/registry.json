{
  "$schema": "./schemas/command-registry.schema.json",
  "registry_version": "1.0.0",
  "wire_protocol": { "major": 1, "minor": 0 },
  "binary": "manuvra",
  "minimum_macos": "26.0",
  "operational_stdout_max_bytes": 4096,
  "error_catalog": "./error-catalog.json",
  "help_baseline": "./agent-help.md",
  "commands": [
    {
      "id": "system.commands.list",
      "cli": ["commands", "list"],
      "summary": "List compact command descriptors from the installed registry.",
      "effect": "read",
      "authority": "none",
      "modes": [],
      "default_timeout_ms": 2000,
      "maximum_timeout_ms": 120000,
      "capabilities": [],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/commands_list",
      "result_schema": "./schemas/command-results.schema.json#/$defs/registry_page",
      "examples": [{ "cli": "manuvra commands list", "input": { "limit": 10 } }],
      "since": "1.0.0"
    },
    {
      "id": "system.commands.get",
      "cli": ["commands", "get"],
      "summary": "Describe one command without assuming project context.",
      "effect": "read",
      "authority": "none",
      "modes": [],
      "default_timeout_ms": 2000,
      "maximum_timeout_ms": 120000,
      "capabilities": [],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/commands_get",
      "result_schema": "./schemas/command-results.schema.json#/$defs/command_help",
      "examples": [{ "cli": "manuvra commands get action.click", "input": { "command": "action.click" } }],
      "since": "1.0.0"
    },
    {
      "id": "system.commands.schema",
      "cli": ["commands", "schema"],
      "summary": "Return the absolute path and digest of a packaged command schema.",
      "effect": "read",
      "authority": "none",
      "modes": [],
      "default_timeout_ms": 2000,
      "maximum_timeout_ms": 120000,
      "capabilities": [],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/commands_schema",
      "result_schema": "./schemas/command-results.schema.json#/$defs/schema_pointer",
      "examples": [{ "cli": "manuvra commands schema action.click --side input", "input": { "command": "action.click", "side": "input" } }],
      "since": "1.0.0"
    },
    {
      "id": "system.commands.errors",
      "cli": ["commands", "errors"],
      "summary": "Explain one stable error code and its safe recovery.",
      "effect": "read",
      "authority": "none",
      "modes": [],
      "default_timeout_ms": 2000,
      "maximum_timeout_ms": 120000,
      "capabilities": [],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/commands_errors",
      "result_schema": "./schemas/command-results.schema.json#/$defs/error_help",
      "examples": [{ "cli": "manuvra commands errors invalid_request", "input": { "code": "invalid_request" } }],
      "since": "1.0.0"
    },
    {
      "id": "system.commands.usage",
      "cli": ["commands", "usage"],
      "summary": "Enable, inspect, export, reset, or disable local aggregate raw-command usage.",
      "effect": "durable_write",
      "authority": "none",
      "modes": [],
      "default_timeout_ms": 5000,
      "maximum_timeout_ms": 120000,
      "capabilities": [],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/commands_usage",
      "result_schema": "./schemas/command-results.schema.json#/$defs/usage_result",
      "examples": [{ "cli": "manuvra commands usage show", "input": { "action": "show" } }],
      "since": "1.0.0"
    },
    {
      "id": "target.list",
      "cli": ["targets"],
      "summary": "Discover current Chrome and macOS targets, their presentation owner and title, and dynamic capabilities.",
      "effect": "read",
      "authority": "none",
      "modes": [],
      "default_timeout_ms": 2000,
      "maximum_timeout_ms": 120000,
      "capabilities": [],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/targets",
      "result_schema": "./schemas/command-results.schema.json#/$defs/target_page",
      "examples": [{ "cli": "manuvra targets", "input": { "limit": 10 } }],
      "since": "1.0.0"
    },
    {
      "id": "session.open",
      "cli": ["open"],
      "summary": "Open a background-by-default actor or observer session on one exact target generation.",
      "effect": "lifecycle",
      "authority": "none",
      "modes": ["background", "foreground"],
      "default_timeout_ms": 5000,
      "maximum_timeout_ms": 120000,
      "capabilities": [],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/open",
      "result_schema": "./schemas/command-results.schema.json#/$defs/session",
      "examples": [{ "cli": "manuvra open --target chrome_example", "input": { "target_id": "chrome_example", "role": "actor", "mode": "background", "lease_ttl_ms": 120000 } }],
      "since": "1.0.0"
    },
    {
      "id": "session.close",
      "cli": ["close"],
      "summary": "Close one session and remove all of its temporary artifacts.",
      "effect": "lifecycle",
      "authority": "session",
      "modes": [],
      "default_timeout_ms": 5000,
      "maximum_timeout_ms": 120000,
      "capabilities": [],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/close",
      "result_schema": "./schemas/command-results.schema.json#/$defs/closed",
      "examples": [{ "cli": "manuvra close --session s_example", "input": { "session_id": "s_example", "cancel_running": false } }],
      "since": "1.0.0"
    },
    {
      "id": "lease.manage",
      "cli": ["lease"],
      "summary": "Explicitly acquire, renew, or release the actor lease for a session.",
      "effect": "coordination",
      "authority": "session",
      "modes": [],
      "default_timeout_ms": 2000,
      "maximum_timeout_ms": 120000,
      "capabilities": [],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/lease",
      "result_schema": "./schemas/command-results.schema.json#/$defs/lease",
      "examples": [{ "cli": "manuvra lease renew --session s_example", "input": { "session_id": "s_example", "action": "renew" } }],
      "since": "1.0.0"
    },
    {
      "id": "action.click",
      "cli": ["click"],
      "summary": "Click one unambiguous semantic, reference, or frame-coordinate target.",
      "effect": "mutate",
      "authority": "actor",
      "modes": ["background", "foreground"],
      "default_timeout_ms": 5000,
      "maximum_timeout_ms": 120000,
      "capabilities": ["common.click", "observation.screenshot"],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/click",
      "result_schema": "./schemas/action-result.schema.json",
      "examples": [{ "cli": "manuvra click --session s_example --role button --name Save", "input": { "session_id": "s_example", "locator": { "kind": "semantic", "role": "button", "name": "Save" }, "button": "left", "count": 1 } }],
      "since": "1.0.0"
    },
    {
      "id": "action.type",
      "cli": ["type"],
      "summary": "Type text into one explicit target; global focus is never implicit.",
      "effect": "mutate",
      "authority": "actor",
      "modes": ["background", "foreground"],
      "default_timeout_ms": 5000,
      "maximum_timeout_ms": 120000,
      "capabilities": ["common.type", "observation.screenshot"],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/type",
      "result_schema": "./schemas/action-result.schema.json",
      "examples": [{ "cli": "manuvra type --session s_example --role textbox --text hello", "input": { "session_id": "s_example", "locator": { "kind": "semantic", "role": "textbox" }, "text": "hello", "replace": false } }],
      "since": "1.0.0"
    },
    {
      "id": "action.press",
      "cli": ["press"],
      "summary": "Press a normalized key against the session target or an explicit element.",
      "effect": "mutate",
      "authority": "actor",
      "modes": ["background", "foreground"],
      "default_timeout_ms": 5000,
      "maximum_timeout_ms": 120000,
      "capabilities": ["common.press", "observation.screenshot"],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/press",
      "result_schema": "./schemas/action-result.schema.json",
      "examples": [{ "cli": "manuvra press --session s_example --key Enter", "input": { "session_id": "s_example", "key": "Enter" } }],
      "since": "1.0.0"
    },
    {
      "id": "action.scroll",
      "cli": ["scroll"],
      "summary": "Scroll the session target or one explicit element by logical deltas.",
      "effect": "mutate",
      "authority": "actor",
      "modes": ["background", "foreground"],
      "default_timeout_ms": 5000,
      "maximum_timeout_ms": 120000,
      "capabilities": ["common.scroll", "observation.screenshot"],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/scroll",
      "result_schema": "./schemas/action-result.schema.json",
      "examples": [{ "cli": "manuvra scroll --session s_example --delta-x 0 --delta-y 480", "input": { "session_id": "s_example", "delta_x": 0.0, "delta_y": 480.0 } }],
      "since": "1.0.0"
    },
    {
      "id": "action.navigate",
      "cli": ["navigate"],
      "summary": "Navigate a target that advertises the common navigate capability.",
      "effect": "mutate",
      "authority": "actor",
      "modes": ["background", "foreground"],
      "default_timeout_ms": 10000,
      "maximum_timeout_ms": 120000,
      "capabilities": ["common.navigate", "observation.screenshot"],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/navigate",
      "result_schema": "./schemas/action-result.schema.json",
      "examples": [{ "cli": "manuvra navigate --session s_example --url https://example.test", "input": { "session_id": "s_example", "url": "https://example.test" } }],
      "since": "1.0.0"
    },
    {
      "id": "observe.query",
      "cli": ["observe", "query"],
      "summary": "Find bounded exact semantic matches and issue session-scoped references.",
      "effect": "read",
      "authority": "observer",
      "modes": [],
      "default_timeout_ms": 2000,
      "maximum_timeout_ms": 120000,
      "capabilities": ["observation.query"],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/observe_query",
      "result_schema": "./schemas/command-results.schema.json#/$defs/query_result",
      "examples": [{ "cli": "manuvra observe query --session s_example --role button --name Save", "input": { "session_id": "s_example", "semantic": { "kind": "semantic", "role": "button", "name": "Save" }, "limit": 5 } }],
      "since": "1.0.0"
    },
    {
      "id": "observe.screenshot",
      "cli": ["observe", "screenshot"],
      "summary": "Capture the exact session target and return an absolute path plus frame token.",
      "effect": "read",
      "authority": "observer",
      "modes": [],
      "default_timeout_ms": 5000,
      "maximum_timeout_ms": 120000,
      "capabilities": ["observation.screenshot"],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/session_only",
      "result_schema": "./schemas/command-results.schema.json#/$defs/screenshot_result",
      "examples": [{ "cli": "manuvra observe screenshot --session s_example", "input": { "session_id": "s_example" } }],
      "since": "1.0.0"
    },
    {
      "id": "observe.tree",
      "cli": ["observe", "tree"],
      "summary": "Write one complete accessibility tree and issue a new reference epoch.",
      "effect": "read",
      "authority": "observer",
      "modes": [],
      "default_timeout_ms": 15000,
      "maximum_timeout_ms": 120000,
      "capabilities": ["observation.complete_tree"],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/session_only",
      "result_schema": "./schemas/complete-tree-result.schema.json",
      "examples": [{ "cli": "manuvra observe tree --session s_example", "input": { "session_id": "s_example" } }],
      "since": "1.0.0"
    },
    {
      "id": "observe.evidence",
      "cli": ["observe"],
      "summary": "Retrieve logs, events, diagnostics, timings, or the artifact manifest by path.",
      "effect": "read",
      "authority": "observer",
      "modes": [],
      "default_timeout_ms": 5000,
      "maximum_timeout_ms": 120000,
      "capabilities": [],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/observe_evidence",
      "result_schema": "./schemas/command-results.schema.json#/$defs/artifact_pointer",
      "examples": [{ "cli": "manuvra observe logs --session s_example", "input": { "session_id": "s_example", "kind": "logs" } }],
      "since": "1.0.0"
    },
    {
      "id": "raw.cdp",
      "cli": ["raw", "cdp"],
      "summary": "Send one semantically unchanged CDP method and preserve its complete reply.",
      "effect": "declared",
      "authority": "actor",
      "modes": ["background", "foreground"],
      "default_timeout_ms": 5000,
      "maximum_timeout_ms": 120000,
      "capabilities": ["raw.cdp"],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/raw_cdp",
      "result_schema": "./schemas/command-results.schema.json#/$defs/raw_cdp_result",
      "examples": [{ "cli": "manuvra raw cdp --session s_example --intent query --method Runtime.evaluate --params '{}'", "input": { "session_id": "s_example", "intent": "query", "method": "Runtime.evaluate", "params": {} } }],
      "since": "1.0.0"
    },
    {
      "id": "raw.ax.get",
      "cli": ["raw", "ax", "get"],
      "summary": "Read exactly one named Accessibility attribute.",
      "effect": "read",
      "authority": "observer",
      "modes": [],
      "default_timeout_ms": 5000,
      "maximum_timeout_ms": 120000,
      "capabilities": ["raw.ax.get"],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/raw_ax_get",
      "result_schema": "./schemas/command-results.schema.json#/$defs/raw_result",
      "examples": [{ "cli": "manuvra raw ax get --session s_example --ref e_example --attribute AXTitle", "input": { "session_id": "s_example", "ref": "e_example", "attribute": "AXTitle" } }],
      "since": "1.0.0"
    },
    {
      "id": "raw.ax.set",
      "cli": ["raw", "ax", "set"],
      "summary": "Set exactly one named Accessibility attribute and capture post-action state.",
      "effect": "mutate",
      "authority": "actor",
      "modes": ["background", "foreground"],
      "default_timeout_ms": 5000,
      "maximum_timeout_ms": 120000,
      "capabilities": ["raw.ax.set", "observation.screenshot"],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/raw_ax_set",
      "result_schema": "./schemas/action-result.schema.json",
      "examples": [{ "cli": "manuvra raw ax set --session s_example --ref e_example --attribute AXValue --value '{\"type\":\"string\",\"value\":\"hello\"}'", "input": { "session_id": "s_example", "ref": "e_example", "attribute": "AXValue", "value": { "type": "string", "value": "hello" } } }],
      "since": "1.0.0"
    },
    {
      "id": "raw.ax.perform",
      "cli": ["raw", "ax", "perform"],
      "summary": "Perform exactly one named Accessibility action and capture post-action state.",
      "effect": "mutate",
      "authority": "actor",
      "modes": ["background", "foreground"],
      "default_timeout_ms": 5000,
      "maximum_timeout_ms": 120000,
      "capabilities": ["raw.ax.perform", "observation.screenshot"],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/raw_ax_perform",
      "result_schema": "./schemas/action-result.schema.json",
      "examples": [{ "cli": "manuvra raw ax perform --session s_example --ref e_example --action AXPress", "input": { "session_id": "s_example", "ref": "e_example", "action": "AXPress" } }],
      "since": "1.0.0"
    },
    {
      "id": "request.cancel",
      "cli": ["cancel"],
      "summary": "Request priority cancellation; the original request retains terminal authority.",
      "effect": "coordination",
      "authority": "session",
      "modes": [],
      "default_timeout_ms": 2000,
      "maximum_timeout_ms": 120000,
      "capabilities": [],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/cancel",
      "result_schema": "./schemas/command-results.schema.json#/$defs/cancel",
      "examples": [{ "cli": "manuvra cancel --session s_example --request-id r_example", "input": { "session_id": "s_example", "request_id": "r_example" } }],
      "since": "1.0.0"
    },
    {
      "id": "artifact.export",
      "cli": ["export"],
      "summary": "Copy selected session evidence to a caller-chosen durable path and verify it.",
      "effect": "durable_write",
      "authority": "session",
      "modes": [],
      "default_timeout_ms": 5000,
      "maximum_timeout_ms": 120000,
      "capabilities": [],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/export",
      "result_schema": "./schemas/command-results.schema.json#/$defs/export",
      "examples": [{ "cli": "manuvra export --session s_example --all --destination /tmp/manuvra-example-evidence", "input": { "session_id": "s_example", "all": true, "destination": "/tmp/manuvra-example-evidence" } }],
      "since": "1.0.0"
    },
    {
      "id": "system.chrome.launch",
      "cli": ["chrome", "launch"],
      "summary": "Launch a dedicated visible Chrome with loopback CDP, or reuse one already answering there.",
      "effect": "lifecycle",
      "authority": "none",
      "modes": [],
      "default_timeout_ms": 15000,
      "maximum_timeout_ms": 120000,
      "capabilities": [],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/empty",
      "result_schema": "./schemas/command-results.schema.json#/$defs/chrome_launch",
      "examples": [{ "cli": "manuvra chrome launch", "input": {} }],
      "since": "1.0.0"
    },
    {
      "id": "daemon.status",
      "cli": ["daemon", "status"],
      "summary": "Report same-user daemon identity, compatibility, admission, sessions, and in-flight work without touching a target.",
      "effect": "read",
      "authority": "none",
      "modes": [],
      "default_timeout_ms": 2000,
      "maximum_timeout_ms": 120000,
      "capabilities": [],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/empty",
      "result_schema": "./schemas/command-results.schema.json#/$defs/daemon_status",
      "examples": [{ "cli": "manuvra daemon status", "input": {} }],
      "since": "1.0.0"
    },
    {
      "id": "daemon.stop",
      "cli": ["daemon", "stop"],
      "summary": "Close daemon admission and stop only after every session and invocation is terminal.",
      "effect": "coordination",
      "authority": "none",
      "modes": [],
      "default_timeout_ms": 5000,
      "maximum_timeout_ms": 120000,
      "capabilities": [],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/empty",
      "result_schema": "./schemas/command-results.schema.json#/$defs/daemon_status",
      "examples": [{ "cli": "manuvra daemon stop", "input": {} }],
      "since": "1.0.0"
    },
    {
      "id": "system.setup",
      "cli": ["setup"],
      "summary": "Ask macOS for missing daemon permissions, recheck each fact, and guide any required human authorization.",
      "effect": "lifecycle",
      "authority": "none",
      "modes": [],
      "default_timeout_ms": 120000,
      "maximum_timeout_ms": 120000,
      "capabilities": [],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/empty",
      "result_schema": "./schemas/command-results.schema.json#/$defs/setup",
      "examples": [{ "cli": "manuvra setup", "input": {} }],
      "since": "1.0.0"
    },
    {
      "id": "system.migrate",
      "cli": ["migrate"],
      "summary": "Copy explicitly selected legacy development configuration into the Manuvra namespace without deleting its source.",
      "effect": "durable_write",
      "authority": "none",
      "modes": [],
      "default_timeout_ms": 5000,
      "maximum_timeout_ms": 120000,
      "capabilities": [],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/migrate",
      "result_schema": "./schemas/command-results.schema.json#/$defs/migrate",
      "examples": [{ "cli": "manuvra migrate --from computer-use", "input": { "from": "computer-use" } }],
      "since": "1.0.0"
    },
    {
      "id": "system.purge",
      "cli": ["purge"],
      "summary": "Remove only enumerated Manuvra-owned current-user roots after explicit confirmation.",
      "effect": "durable_write",
      "authority": "none",
      "modes": [],
      "default_timeout_ms": 5000,
      "maximum_timeout_ms": 120000,
      "capabilities": [],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/purge",
      "result_schema": "./schemas/command-results.schema.json#/$defs/purge",
      "examples": [{ "cli": "manuvra purge --all --yes", "input": { "all": true, "yes": true } }],
      "since": "1.0.0"
    },
    {
      "id": "system.doctor",
      "cli": ["doctor"],
      "summary": "Report host, daemon, permissions, sessions, leases, and target capability diagnostics.",
      "effect": "read",
      "authority": "none",
      "modes": [],
      "default_timeout_ms": 5000,
      "maximum_timeout_ms": 120000,
      "capabilities": [],
      "input_schema": "./schemas/command-inputs.schema.json#/$defs/doctor",
      "result_schema": "./schemas/command-results.schema.json#/$defs/doctor",
      "examples": [{ "cli": "manuvra doctor", "input": {} }],
      "since": "1.0.0"
    }
  ]
}
