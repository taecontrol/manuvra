{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manuvra.local/schema/error-catalog/1",
  "title": "Manuvra error catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "errors", "warnings"],
  "properties": {
    "$schema": { "type": "string" },
    "catalog_version": { "const": "1.0.0" },
    "errors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/error" } },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } }
  },
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "phase", "effects", "retry", "exit", "meaning", "recovery"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "category": { "enum": ["interface", "version", "target", "session", "coordination", "capability", "resolution", "execution", "evidence", "raw", "durable_state", "internal"] },
        "phase": { "enum": ["transport", "validation", "preflight", "dispatch", "stabilization", "capture", "artifact", "cleanup"] },
        "effects": { "enum": ["none", "possible", "confirmed"] },
        "retry": { "enum": ["never", "immediate", "after_condition", "observe_then_decide"] },
        "exit": { "enum": [2, 3, 4, 5, 6, 7, 70, 130] },
        "meaning": { "type": "string", "minLength": 1, "maxLength": 256 },
        "recovery": { "type": ["string", "null"], "maxLength": 512 }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "meaning", "recovery"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "meaning": { "type": "string", "minLength": 1, "maxLength": 256 },
        "recovery": { "type": ["string", "null"], "maxLength": 512 }
      }
    }
  }
}
