{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manuvra.local/schema/protocol/1",
  "title": "Manuvra JSON-RPC invocation protocol",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/result_response" },
    { "$ref": "#/$defs/rpc_error_response" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "method": { "const": "manuvra.invoke" },
        "params": { "$ref": "#/$defs/invocation" }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "registry_version", "build_digest", "request_id", "deadline_ms", "command", "input"],
      "properties": {
        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": ["major", "minimum_minor", "maximum_minor"],
          "properties": {
            "major": { "const": 1 },
            "minimum_minor": { "type": "integer", "minimum": 0 },
            "maximum_minor": { "type": "integer", "minimum": 0 }
          }
        },
        "registry_version": { "type": "string", "const": "1.0.0" },
        "build_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "deadline_ms": { "type": "integer", "minimum": 50, "maximum": 120000 },
        "command": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)+$", "maxLength": 64 },
        "input": { "type": "object" }
      }
    },
    "result_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "result": { "type": "object" }
      }
    },
    "rpc_error_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": ["string", "null"], "maxLength": 128 },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "integer" },
            "message": { "type": "string", "maxLength": 256 },
            "data": { "type": "object" }
          }
        }
      }
    }
  }
}
